PORT=4000

# Docker image each new app's container is created from.
APP_IMAGE=node:20-alpine

# Host folder where each app's persistent /app data is stored
# (one subfolder per app, named by its appId).
DATA_ROOT=./data

# "docker" (own server with Docker) or "process" (Render and similar hosts)
RUNTIME=docker
# Required when RUNTIME=process. Log in with any username and this password.
PANEL_PASSWORD=
